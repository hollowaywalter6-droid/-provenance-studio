{
  "manifest_version": 3,
  "name": "Provenance Canvas Lens",
  "version": "2.0.0",
  "description": "Provenance Canvas Lens inline review overlay with dynamic Canvas detection, mobile-friendly dock, current-selection awareness, and local review notes.",
  "permissions": [],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://canvas.sdsu.edu/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://canvas.sdsu.edu/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}