{
  "manifest_version": 3,
  "name": "Provenance Canvas Lens",
  "version": "2.5.0",
  "description": "Provenance Canvas Lens 2.5: compact review plus explicitly gated practice Auto-select, Auto-fill, and Auto-submit toggles.",
  "permissions": [],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://canvas.sdsu.edu/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://canvas.sdsu.edu/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
