{
  "manifest_version": 3,
  "name": "Provenance Canvas Lens",
  "version": "2.2.1",
  "description": "Provenance Canvas Lens 2.2.1: compact mobile overlay, concise selection-neutral Canvas review, deduplication, filtering, and confirmed review feedback.",
  "permissions": [],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://canvas.sdsu.edu/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://canvas.sdsu.edu/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
