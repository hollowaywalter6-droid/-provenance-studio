{
  "manifest_version": 3,
  "name": "Provenance Canvas Lens",
  "version": "2.3.0",
  "description": "Provenance Canvas Lens 2.3: compact selection-neutral review with Locate, Copy Cue, Next, filtering, deduplication, and confirmed review feedback.",
  "permissions": [],
  "host_permissions": [
    "https://*.instructure.com/*",
    "https://canvas.sdsu.edu/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.instructure.com/*",
        "https://canvas.sdsu.edu/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
